{
  "name": "@ak2021/web-components",
  "version": "0.0.3-beta.6",
  "description": "web components",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./dist/style/css.css": "./dist/style/css.css",
    "./dist/style/css.js": "./dist/style/css.js",
    "./dist/style/index.js": "./dist/style/index.js",
    "./dist/style": "./dist/style/index.js"
  },
  "scripts": {
    "dev": "npm run clean && cross-env NODE_ENV=development rollup --config rollup.config.mjs --watch",
    "build": "npm run clean && cross-env NODE_ENV=production rollup --config rollup.config.mjs",
    "clean": "rimraf dist"
  },
  "keywords": [
    "webcomponents",
    "components",
    "web"
  ],
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "author": "ShineShao <xiaoshaoqq@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "@skax/picker": "^2.0.0-alpha.1"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeshineit/pnpm-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/freeshineit/pnpm-workspace/issues"
  },
  "homepage": "https://github.com/freeshineit/pnpm-workspace#readme"
}
